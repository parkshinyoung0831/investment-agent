# Local secrets and runtime settings — do not commit .env

# =========================================================
# Supabase — 대부분의 ETL·알림에서 필수
# =========================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Postgres 직결 — 스키마 적용·점검용. 로컬 전용이며 CI에 주입하지 않는다.
SUPABASE_DB_URL=

# 현재 실행 경로에서는 사용하지 않음. 공개 읽기 클라이언트 사용 시에만 필요
SUPABASE_ANON_KEY=

# 로컬 DB·Parquet·artifact의 공통 루트. 개별 경로가 비어 있을 때만 사용한다.
AI_INVESTOR_LOCAL_DATA_ROOT=data/local
AI_INVESTOR_LOCAL_ARTIFACT_ROOT=

# 저장소별 override. 비우면 위 공통 루트 아래의 canonical 경로를 사용한다.
AI_INVESTOR_INTELLIGENCE_DB_PATH=
AI_INVESTOR_INTELLIGENCE_PARQUET_ROOT=
INVESTMENT_AGENT_RESEARCH_ROOT=
AI_INVESTOR_RUNTIME_DB_PATH=
AI_INVESTOR_MARKET_CHANGE_MANIFEST_PATH=


# =========================================================
# SEC EDGAR — Universe·Fundamentals·Segments·Gurus 필수
# 이름과 실제 연락 가능한 이메일을 포함한다.
# 예: EDGAR_USER_AGENT="Your Name your-email@example.com"
# =========================================================
EDGAR_USER_AGENT=
SEC_REQUEST_GAP_SEC=0.12


# =========================================================
# Macro 데이터 공급자 & 지표 일정
# =========================================================
FRED_API_KEY=
ECOS_API_KEY=
EIA_API_KEY=
MACRO_SOURCE_BUDGET_SEC=360
MACRO_NOTIFY_FORCE=false

# Econ Calendar ICS 저장용 버킷 이름
ECON_CALENDAR_ICS_BUCKET=econ-calendar



# =========================================================
# Gurus
# =========================================================
# 미설정해도 실행되지만 CUSIP 매핑 처리량이 낮아질 수 있다.
OPENFIGI_API_KEY=
GURUS_POLL_WINDOW_DAYS=7
# 13F 이력을 어디서부터 받을지. 비우면 코드 기본값을 쓴다.
GURUS_HISTORICAL_START_DATE=
GURUS_SHADOW_PARSER=off

# 같은 알림을 수동으로 다시 보낼 때만 true
GURUS_NOTIFY_FORCE=false


# =========================================================
# Fundamentals & Segments 설정
# =========================================================
FUNDAMENTALS_INDEX_LOOKBACK_DAYS=7
FUNDAMENTALS_NOTIFY_LOOKBACK_DAYS=7
FUNDAMENTALS_EXPECTATIONS_WORKERS=4
FUNDAMENTALS_CALENDAR_FORCE=false

FUNDAMENTALS_FAST_LEAD_DAYS=5
FUNDAMENTALS_FAST_LAG_DAYS=10
FUNDAMENTALS_FAST_STALE_DAYS=7

NOTIFY_FLASH_FORCE=false
FLASH_NOTIFY_LOOKBACK_DAYS=7



# =========================================================
# Broker adapter — 허용 IP와 별도 운영 환경이 준비된 로컬 장비에서만 사용
# GitHub Actions에는 주입하지 않는다.
# =========================================================
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 비우면 artifacts/toss_auth/oauth-token.json 사용
TOSS_TOKEN_CACHE_PATH=
TOSS_ACCOUNT_SEQ=
TOSS_MIN_ORDER_NOTIONAL_USD=10
TOSS_MAX_ORDER_NOTIONAL_USD=5000
TOSS_MAX_TOTAL_NOTIONAL_USD=20000
# 아래 실주문 플래그는 승인 서비스·재검증·reconciliation까지 준비된 고정 IP 장비에서만 true
TOSS_LIVE_ENABLED=false
TOSS_MAX_DAILY_NOTIONAL_USD=20000
TOSS_MAX_DAILY_ORDERS=20
TOSS_MAX_DAILY_LOSS_USD=500
TOSS_MAX_DRAWDOWN_FRACTION=0.05
TOSS_ALLOW_MARKET_ORDERS=false
TRADING_KILL_SWITCH=on

# 실행 안전장치. DB durable control/permit도 함께 통과해야 한다.
LIVE_ENABLED=false

# 로컬 하네스. NY 시각이며 실주문 가능 구간보다 보수적으로 잡는다.
HARNESS_NY_SESSION_START=09:40
HARNESS_NY_SESSION_END=14:30
HARNESS_NY_RISK_START=09:15
HARNESS_NY_RISK_END=16:30
HARNESS_APPROVAL_POLL_SEC=15
HARNESS_ANALYSIS_TIMEOUT_SEC=7200
HARNESS_APPROVAL_REQUEST_TIMEOUT_SEC=180
HARNESS_EXECUTION_TIMEOUT_SEC=600
HARNESS_RISK_SNAPSHOT_TIMEOUT_SEC=180
HARNESS_RECONCILE_TIMEOUT_SEC=180
# 비우면 각 job은 실행 가능하다. 중단할 때만 on으로 둔다.
HARNESS_JOB_INVESTMENT_ANALYSIS_KILL_SWITCH=off
HARNESS_JOB_INVESTMENT_PIPELINE_KILL_SWITCH=off
HARNESS_JOB_ACCOUNT_RISK_SNAPSHOT_KILL_SWITCH=off
HARNESS_JOB_TOSS_RECONCILIATION_KILL_SWITCH=off

# 운영 하트비트 외부 모니터링 핑 URL (선택 사항)
OPS_HEARTBEAT_PING_URL=


# =========================================================
# Discord
# =========================================================
DISCORD_BOT_TOKEN=

# 운영 사건·heartbeat 전송 Webhook. 설정 권장
DISCORD_WEBHOOK_OPS=

# Discord 개발자 모드에서 복사한 숫자 채널 ID
DISCORD_CHANNEL_MACRO_DAILY=
DISCORD_CHANNEL_ECON_CALENDAR_RELEASE=
DISCORD_CHANNEL_MACRO_ALERT=
DISCORD_CHANNEL_EARNINGS=
DISCORD_CHANNEL_EARNINGS_CALENDAR=
DISCORD_CHANNEL_GURUS=
DISCORD_CHANNEL_STRATEGY_MONTHLY=
DISCORD_CHANNEL_STRATEGY_FORUM=
DISCORD_CHANNEL_SYSTEM_LOG=

# 대시보드에서 운영 원문으로 이동할 때 쓰는 선택 링크
DISCORD_SYSTEM_LOG_URL=
GITHUB_ACTIONS_URL=

# Discord Lab 채널 (테스트/실험 발송용)
DISCORD_CHANNEL_LAB_CARDS=
DISCORD_CHANNEL_LAB_OPS=
DISCORD_CHANNEL_LAB_FORUM=

# 건별 투자 승인은 카드 발송/서버관리 봇과 분리한다.
DISCORD_APPROVAL_BOT_TOKEN=
DISCORD_CHANNEL_AI_APPROVALS=
DISCORD_APPROVER_USER_IDS=
DISCORD_APPROVAL_HMAC_SECRET=
# 비우면 artifacts/execution/approval-hmac.key를 현재 사용자 전용으로 자동 생성
DISCORD_APPROVAL_HMAC_SECRET_FILE=
AI_APPROVAL_TTL_MINUTES=15

# Discord 채널 구조를 로컬에서 동기화할 때만 사용한다.
# 봇이 채널을 이름으로 찾을 때 쓴다(거장 포럼 등). 자격증명이 아니라 ID다.
DISCORD_GUILD_ID=
DISCORD_ADMIN_TOKEN=


# =========================================================
# AI Investor — 로컬 Shadow 전용
# Ollama 예: BASE_URL=http://127.0.0.1:11434, MODEL=qwen3:8b
# =========================================================
AI_INVESTOR_MODE=shadow
AI_INVESTOR_BASE_URL=
AI_INVESTOR_MODEL=
AI_INVESTOR_QUICK_MODEL=
AI_INVESTOR_DEEP_MODEL=
AI_INVESTOR_API_KEY=
AI_INVESTOR_PROVIDER=openai_compatible
# TradingAgents가 인식하는 provider 이름. Ollama는 ollama, OpenAI는 openai.
AI_INVESTOR_TRADINGAGENTS_PROVIDER=
# yfinance는 key가 없고 live 보조용이다. alpha_vantage 선택 시 아래 key가 필수다.
AI_INVESTOR_TRADINGAGENTS_NEWS_VENDOR=yfinance
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
AI_INVESTOR_EXTERNAL_NEWS_SOCIAL=true
# 공식 접근 승인을 준비한 provider만 쉼표로 명시한다. 기본은 소셜 비활성.
AI_INVESTOR_EXTERNAL_SOCIAL_VENDORS=
# StockTwits API/서면 허가를 실제로 받은 경우에만 true. consumer 구독은 해당하지 않는다.
STOCKTWITS_API_ACCESS_APPROVED=false
AI_INVESTOR_EXTERNAL_MAX_AGE_HOURS=24
AI_INVESTOR_EXTERNAL_MAX_CHARS=12000
# 공급자 실제 HTTP 호출 종목별 상한. 기본 5종목이면 최대 20회라 무료 25회/일 안쪽이다.
AI_INVESTOR_EXTERNAL_MAX_CALLS_PER_TICKER=4
# UTC 날짜별 provider cap. 목록에 없는 새 provider는 네트워크 전에 차단된다.
AI_INVESTOR_EXTERNAL_DAILY_CAPS=yfinance=25,alpha_vantage=25
# 비우면 AI_INVESTOR_ARTIFACT_DIR/metadata/external-usage.sqlite3 사용. 원문은 기록하지 않는다.
AI_INVESTOR_EXTERNAL_USAGE_LEDGER_PATH=
# provider 응답 원문은 Supabase에 저장하지 않는다. 아래는 별도 run artifact 저장 옵션이다.
AI_INVESTOR_SAVE_EXTERNAL_RAW=false
# 재생성 가능한 DuckDB cache. historical replay는 이 파일을 절대 열지 않는다.
AI_INVESTOR_LOCAL_NEWS_CACHE_ENABLED=true
AI_INVESTOR_NEWS_CACHE_PATH=data/local/news_social.duckdb
AI_INVESTOR_ARTIFACT_DIR=artifacts/ai_investor/tradingagents
AI_INVESTOR_TIMEOUT_SEC=180
AI_INVESTOR_DAILY_LIMIT=5
AI_INVESTOR_SIGNAL_TTL_HOURS=24


# =========================================================
# 공통
# =========================================================
LOG_LEVEL=INFO

# GitHub Actions 킬 스위치는 .env가 아닌 Repository Variables에 둔다.
# FUNDAMENTALS_KILL=off
# GURUS_KILL=off
# ECON_CALENDAR_KILL=off

# --- 선택 설정 (비우면 코드 기본값) ---------------------------------------
# 세그먼트 수집 창과 동시 실행 수
FUNDAMENTALS_SEGMENT_LOOKBACK_DAYS=
FUNDAMENTALS_SEGMENT_WORKERS=
# 대시보드: 외부 호출 없이 띄우기, 하네스 stale 판정 초, 뉴스 provider 표시
DASHBOARD_OFFLINE=
DASHBOARD_HARNESS_STALE_SECONDS=
DASHBOARD_NEWS_PROVIDER=

# graphify: 날짜별 과거 백업 폴더(YYYY-MM-DD) 생성 방지 (1로 설정 시 백업 비활성화)
GRAPHIFY_NO_BACKUP=1
